rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return userDocExists() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : null;
    }

    function isAdmin() {
      return isLoggedIn() && userDocExists() && getUserRole() == "admin";
    }

    function isCommercial() {
      let role = getUserRole();
      return isLoggedIn() && userDocExists() && (role == "commercial" || role == "admin" || role == "fournisseur");
    }

    function isFournisseur() {
      return isLoggedIn() && userDocExists() && getUserRole() == "fournisseur";
    }

    match /users/{userId} {
      // Only the owner or an admin can read a user doc. Listing all users is
      // restricted to admins to avoid leaking every user's email/role/phone.
      allow get: if isLoggedIn() && (isOwner(userId) || isAdmin() || isCommercial() || isFournisseur());
      allow list: if isAdmin();
      allow write: if isLoggedIn() && (isOwner(userId) || isAdmin());
    }

    match /roles/{roleId} {
      // Only admins can list all role definitions; everyone can fetch a single role by id.
      allow get: if isLoggedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /quotes/{quoteId} {
      allow read: if isAdmin() || isCommercial() || (isFournisseur() && resource.data.supplierId == request.auth.uid);
      allow create: if isLoggedIn();
      allow update: if isAdmin() || (isFournisseur() && resource.data.supplierId == request.auth.uid);
      allow list: if isAdmin() || isCommercial() || isFournisseur();
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow list: if isLoggedIn();
      allow write: if isAdmin();
    }
    
    match /characteristics/{charId} {
      allow read: if true;
      allow list: if isLoggedIn();
      allow write: if isAdmin();
    }

    match /boutique_products/{productId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }
    
    match /boutique_characteristics/{charId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    match /product_specs/{productId} {
      allow read: if true;
      allow list: if isLoggedIn();
      allow write: if isAdmin();
    }

    match /cities/{cityId} {
      allow read: if true;
      allow write: if isAdmin();
      allow list: if isAdmin();
    }

    match /zones/{zoneId} {
      allow read: if true;
      allow list: if isLoggedIn();
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow list: if isLoggedIn();
      allow write: if isAdmin();
    }

    match /uploads/{uploadId} {
      allow read: if true;
      allow list: if isLoggedIn();
      allow create, delete: if isLoggedIn() && isAdmin();
    }

    match /notifications/{notificationId} {
      // Users can only list their own notifications, not everyone's.
      allow get: if isLoggedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isLoggedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isLoggedIn();
      allow update, delete: if isLoggedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

match /promo_codes/{codeId} {
  allow read, list: if true;
  allow create, update, delete: if isAdmin();
}

match /system_messages/{messageId} {
  allow read, list: if true;
  allow create, update, delete: if isAdmin();
}

    match /chats/{chatId} {
      allow read, list, update: if isLoggedIn() && (request.auth.uid in resource.data.participants || isAdmin() || isCommercial());
      allow create: if isLoggedIn() && (request.auth.uid in request.resource.data.participants || isAdmin() || isCommercial());
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read, list, create: if isLoggedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants || isAdmin() || isCommercial());
        allow update: if isLoggedIn() && (resource.data.userId == request.auth.uid || isAdmin());
        allow delete: if isAdmin();
      }
    }
  }
}