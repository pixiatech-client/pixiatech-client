rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Secure chats uploads: only authenticated users up to 25MB per file
    match /chats/{chatId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.resource == null ||
        request.resource.size <= 25 * 1024 * 1024
      );
    }

    match /site/hero/{fileName} {
      // Images du Hero du site public : lecture publique, écriture admin uniquement.
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg|image/png|image/webp');
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size <= 25 * 1024 * 1024;
    }
  }
}
