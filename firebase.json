{
  "hosting": [
    {
      "target": "app",
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "ssrstudio9205859220a644",
            "region": "us-central1"
          }
        }
      ]
    },
    {
      "target": "widget",
      "public": "chatbot-widget/dist",
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        }
      ]
    }
  ],
  "firestore": {
    "rules": "src/firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}